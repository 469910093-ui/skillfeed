# skill-feed API（复制为 .env 或导出到环境变量）
# 会话 cookie 的 HMAC 签名密钥。缺了服务直接拒绝启动（fail-closed）。
# 这里刻意不给默认值：填在示例文件里的密钥等于公开密钥，任何人都能自签 cookie
# 冒充任意用户。自己生成一个：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SKILLFEED_SESSION_SECRET=
# 部署后必须改成国内主站的 https 地址：这个值同时决定
#   1) 微信/GitHub 授权回调地址怎么拼
#   2) 会话 cookie 要不要带 Secure（不是 https 就不带，本地 http 才调得动）
SKILLFEED_PUBLIC_URL=http://127.0.0.1:8787

# —— 主站强制登录（第 2 期定案）——
# 默认就是 1。设 0 只该出现在本机开发里：关掉之后 Feed 和各 API 对未登录者开放。
SKILLFEED_REQUIRE_LOGIN=1

# —— 微信服务号网页授权（主登录方式）——
# 服务号后台 → 开发 → 基本配置 拿 AppID / AppSecret；
# 并在「网页授权域名」里填 SKILLFEED_PUBLIC_URL 的域名（不带协议、不带端口）。
# ⚠️ AppSecret 只在服务端 → 微信 API 这一跳里出现，不会进任何响应体或日志。
SKILLFEED_WECHAT_APP_ID=
SKILLFEED_WECHAT_APP_SECRET=
# snsapi_userinfo：弹一次授权，能拿昵称头像（默认）
# snsapi_base：静默授权，只有 openid，「我的账户」就没有头像昵称可显示
SKILLFEED_WECHAT_SCOPE=snsapi_userinfo

# —— 手机号验证码兜底 ——
# 小红书 / 抖音内置浏览器里微信授权走不通，这条是那些用户唯一的入口。
# provider：aliyun = 真发；console = 只打服务端日志（仅 SKILLFEED_DEV=1 可用）；
# 留空 = 未配置，/auth/sms/send 直接 503（不会静默降级成打日志）
SKILLFEED_SMS_PROVIDER=
# 阿里云短信控制台：签名管理 / 模板管理 / AccessKey
# 模板正文里的变量名要是 ${code}，例：您的验证码是 ${code}，5 分钟内有效。
SKILLFEED_SMS_SIGN_NAME=
SKILLFEED_SMS_TEMPLATE_CODE=
SKILLFEED_SMS_ACCESS_KEY_ID=
SKILLFEED_SMS_ACCESS_KEY_SECRET=
SKILLFEED_SMS_REGION=cn-hangzhou
# 验证码有效期 / 单个码最多猜几次 / 重发冷却（秒）
SKILLFEED_SMS_CODE_TTL_S=300
SKILLFEED_SMS_MAX_ATTEMPTS=5
SKILLFEED_SMS_RESEND_COOLDOWN_S=60
# 防刷窗口与配额。默认「同手机号 1 小时 5 条 / 同 IP 1 小时 20 条」。
# 放大这几个值等于放大短信账单和「拿别人号码当轰炸靶子」的空间，慎改。
SKILLFEED_SMS_WINDOW_S=3600
SKILLFEED_SMS_MAX_PER_PHONE=5
SKILLFEED_SMS_MAX_PER_IP=20
SKILLFEED_SMS_MAX_VERIFY_PER_IP=30

# GitHub 登录在 V1 降为可选「绑定」，登录页默认不给入口（代码和路由都保留）。
# 设 1 才把按钮显示出来。
SKILLFEED_GITHUB_LOGIN_VISIBLE=0
SKILLFEED_GITHUB_CLIENT_ID=
SKILLFEED_GITHUB_CLIENT_SECRET=
# 运营账号（GitHub login，逗号分隔，小写比对）。
# 必须先 GitHub 登录，login 在这份名单里才能开 /op、/admin。
# 后台不提供加人入口，加人就改这里后重启 skillfeed-api。
SKILLFEED_OPERATOR_LOGINS=
# 投稿进审后推一条。飞书：群设置 → 自定义机器人 → webhook。
# 空 = 只写库，不发 IM（投稿页仍显示「审核中」）。
SKILLFEED_REVIEW_WEBHOOK=

# 官方发现源。**默认留空**，此时读服务器本地的 publish-site 产物
# （SKILLFEED_SITE_DIR/feed.json），同源、零出网。
# 曾经默认指向 https://469910093-ui.github.io/... —— 主站搬到国内域名后，
# 让浏览器/服务器跨境拉首屏数据不可靠，所以不再作为默认值。
# 要指到别处（比如内网或 CDN 上的同源地址）才填这一项。
SKILLFEED_OFFICIAL_FEED_URL=
# publish-site 的产物目录（默认 ~/.skill-feed/site）。
# 里面的 index.html 会被 GET / 直接发出去，feed.json 供 GET /feed.json。
#   python skillfeed.py publish-site --out ~/.skill-feed/site
# SKILLFEED_SITE_DIR=
# 单独指定 feed.json 位置（默认 SKILLFEED_SITE_DIR/feed.json）
# SKILLFEED_OFFICIAL_FEED_FILE=
# SQLite 路径（默认 ~/.skill-feed/server.db）
# SKILLFEED_DB=
# 用户库备份目录与保留份数。户口/帖子在这份库里，不在 GitHub。
# SKILLFEED_BACKUP_DIR=
# SKILLFEED_BACKUP_KEEP=14
# CORS（逗号分隔）。国内主站是同源访问，不需要跨域；这里保留的是
# 老的 Pages 站点和本机端口
SKILLFEED_CORS_ORIGINS=https://469910093-ui.github.io,http://127.0.0.1:8473,http://127.0.0.1:8787
# 阿里云百炼（通义千问）：生成卡片的中英双语人话文案。
# 不填也能构建，但卡片会退回 SKILL.md 原文，出现中英混排。
DASHSCOPE_API_KEY=
# 工作空间维度的 key（sk-ws-… 开头）必须配它自己的域名，在百炼 API-KEY 页面
# 的 openAiCompatible 一栏能看到；通用 key 留空即可。
# 例：https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# GitHub API token：不填时 github-search 走未认证限流，供给会明显变少
GITHUB_TOKEN=
# 本地开发总开关。设 1 才允许临时会话密钥和无凭据登录等降级路径；
# 生产不要设它——「漏配某个变量」只会让站点更严，不会让它变得能随便登进来。
SKILLFEED_DEV=0
# 无凭据登录 /auth/dev-login，需要 SKILLFEED_DEV=1 同时在才生效
SKILLFEED_DEV_AUTH=0
# 受信反向代理。两个都要设才会读 X-Forwarded-For 做限流分桶。
# ⚠️ 默认值（直连）和生产值不同，这是最容易踩的坑：
#   - 本地 / 直连：都留默认，按 socket 对端地址分桶
#   - 阿里云轻量 + 同机 Nginx：HOPS=1，IPS=127.0.0.1
#   - CDN → Nginx 两层：HOPS=2，IPS=<Nginx 出口地址>
# 只配 HOPS 不配 IPS 无效：没有可信对端就判断不出请求是否真走过代理，
# 这时读 XFF 等于让任何人伪造一个头就换一个限流桶。
# 反过来，部署在 Nginx 后面却不配，全站会共用同一个桶。
SKILLFEED_TRUSTED_PROXY_HOPS=0
SKILLFEED_TRUSTED_PROXY_IPS=
# 运维只读令牌：给监控探针和 CI 拉 /api/events/health（埋点摄入健康）和
# /api/stats/items（站内热度导出，build 期烧进静态 feed.json）用。
# 不设这两个端点也能访问，但只能带登录态——不会退化成公开可读。
# 走令牌而不是公开：/api/events/health 含限流命中数，公开一个会随请求增长的
# 计数器，等于把「静默丢弃不告诉刷量的人阈值」这道设计原样送回去。
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SKILLFEED_METRICS_TOKEN=
# 免费登录用户每个东八区自然日可解锁的发现条数。订阅后不限。
SKILLFEED_FREE_DAILY_ITEMS=8
# 激活码兑换订阅的天数；0 = 终身。逗号分隔，可重复使用（内测券）。
SKILLFEED_SUBSCRIBER_DAYS=365
SKILLFEED_ACTIVATION_CODES=
# 年费档标价（分）。定价未锁定，先用来把订单金额钉死。
SKILLFEED_SKU_YEAR_FEN=9900
# 微信支付商户。三件都齐才算配置好；验签还没写，现在填了 notify 也是 503。
# 测开通请 SKILLFEED_DEV=1 后走 /api/pay/dev-notify。
SKILLFEED_WECHAT_PAY_MCHID=
SKILLFEED_WECHAT_PAY_API_V3_KEY=
SKILLFEED_WECHAT_PAY_SERIAL=
